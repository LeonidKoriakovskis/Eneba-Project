# Server Configuration
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Connection String
DATABASE_URL=postgres://eneba_user:eneba_password@localhost:5432/eneba_marketplace?sslmode=disable

# Authentication & Security
JWT_SECRET=super-secret-development-jwt-key-change-in-production-min32chars
JWT_EXPIRATION_HOURS=72

# Frontend Base URL (Stripe Checkout redirects & email CTA links)
FRONTEND_URL=http://localhost:5173

# Optional Stripe Checkout (Test Mode) - leave empty to use simulated fallback
STRIPE_SECRET_KEY=

# Optional Transactional Emails via Resend - leave empty for stdout email previews or SMTP
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional: Brevo HTTPS Transactional Email API (port 443) - prioritized first (recommended on Render/cloud hosts)
BREVO_API_KEY=

# Optional SMTP (e.g., Brevo smtp-relay.brevo.com:587 or Gmail App Password) - fallback when BREVO_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
