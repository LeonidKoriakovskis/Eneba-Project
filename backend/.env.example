# Server Configuration
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Connection String (Local Docker/Postgres or Neon cloud Postgres with ?sslmode=require)
DATABASE_URL=postgres://eneba_user:eneba_password@localhost:5432/eneba_marketplace?sslmode=disable
# Optional unpooled Neon URL for DDL migrations via `go run ./cmd/migrate`:
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security (minimum 32 random characters in production)
JWT_SECRET=replace-with-32-char-random-secret-key-for-production
JWT_EXPIRATION_HOURS=72

# Frontend Base URL (Stripe Checkout redirects & email "CLICK TO SEE KEY" CTAs)
FRONTEND_URL=http://localhost:5173
# Production example: FRONTEND_URL=https://eneba-project-lime.vercel.app

# Optional: Stripe Checkout (Test Mode) - leave empty to use built-in simulated payment fallback
STRIPE_SECRET_KEY=

# Optional: Brevo HTTPS Transactional Email API (port 443) - prioritized first (recommended on Render)
BREVO_API_KEY=
SMTP_FROM=

# Optional Fallback: STARTTLS SMTP (used only when BREVO_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Fallback: Resend API
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
