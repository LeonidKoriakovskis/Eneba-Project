# Server Configuration
PORT=8080
ENV=development
# Comma-separated list of allowed frontend origins (e.g. local Vite + deployed Vercel URL)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Alias supported for backward compatibility:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (Local Docker / PostgreSQL or Cloud Neon / Supabase)
# Local Docker / PostgreSQL default:
DATABASE_URL=postgres://eneba_user:eneba_password@localhost:5432/eneba_marketplace?sslmode=disable

# Remote Neon / Supabase cloud example (sslmode=require):
# DATABASE_URL=postgres://username:password@ep-xyz-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

POSTGRES_USER=eneba_user
POSTGRES_PASSWORD=eneba_password
POSTGRES_DB=eneba_marketplace
POSTGRES_PORT=5432

# Authentication & Security
JWT_SECRET=super-secret-development-jwt-key-change-in-production-min32chars
JWT_EXPIRATION_HOURS=72
